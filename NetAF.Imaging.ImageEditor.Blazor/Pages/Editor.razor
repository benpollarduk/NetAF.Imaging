@page "/"
@page "/editor"
@using System.Text
@using System.Collections.Generic
@using NetAF.Assets
@using NetAF.Targets.Console.Rendering
@using NetAF.Imaging
@using NetAF.Imaging.Textures
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>NetAF.Imaging Editor</PageTitle>

<div class="editor-root">
    <header class="app-header">
        <h1>NetAF.Imaging Editor</h1>
    </header>

    <div class="editor-layout">
        <aside class="sidebar">
            <section class="panel">
                <h2 class="panel-title">Canvas</h2>
                <div class="field-row">
                    <div class="field">
                        <label>Width</label>
                        <input type="number" min="1" max="@MaxWidth" @bind="pendingWidth" class="dim-input" />
                    </div>
                    <div class="field">
                        <label>Height</label>
                        <input type="number" min="1" max="@MaxHeight" @bind="pendingHeight" class="dim-input" />
                    </div>
                </div>
                <div class="field">
                    <label>Cell Aspect Ratio</label>
                    <select @bind="selectedAspectRatio" class="tool-select full-width">
                        <option value="@AspectRatioOption.Console">Console (0.55 : 1)</option>
                        <option value="@AspectRatioOption.Square">Square (1 : 1)</option>
                        <option value="@AspectRatioOption.Custom">Custom</option>
                    </select>
                </div>
                <div class="field">
                    <label>Cell Ratio (W : H)</label>
                    <div class="inline">
                        <input type="number" min="0.1" max="10" step="0.1" @bind="cellRatioWidth" class="ratio-input" />
                        <span class="sep">:</span>
                        <input type="number" min="0.1" max="10" step="0.1" @bind="cellRatioHeight" class="ratio-input" />
                    </div>
                </div>
                <div class="btn-row">
                    <button class="btn btn-primary btn-sm" @onclick="ResizeGrid">Apply Size</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearGrid">Clear</button>
                </div>
            </section>

            <section class="panel">
                <h2 class="panel-title">Image</h2>
                <div class="field">
                    <label>Texturizer</label>
                    <select @bind="selectedTexturizer" class="tool-select full-width">
                        <option value="@TexturizerOption.None">None</option>
                        <option value="@TexturizerOption.Brightness">Brightness</option>
                    </select>
                </div>
                <label class="btn btn-outline-primary btn-sm load-image-btn full-width">
                    Load from File
                    <InputFile OnChange="LoadImage" accept="image/*" style="display:none" />
                </label>
                <div class="field">
                    <label>From URL</label>
                    <input type="text" placeholder="https://..." @bind="imageUrl" class="url-input full-width" />
                </div>
                <button class="btn btn-outline-primary btn-sm full-width" @onclick="LoadImageFromUrl">Load from URL</button>
            </section>

            <section class="panel">
                <h2 class="panel-title">Brush</h2>
                <div class="field-row">
                    <div class="field">
                        <label>Background</label>
                        <input type="color" @bind="background" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label>Foreground</label>
                        <input type="color" @bind="foreground" @bind:event="oninput" />
                    </div>
                </div>
                <div class="field">
                    <label>Character</label>
                    <input type="text" maxlength="1" @bind="brushChar" @bind:event="oninput" class="char-input" />
                </div>
            </section>

            <section class="panel">
                <h2 class="panel-title">Palette <span class="count">@palette.Count</span></h2>
                <div class="palette-target">
                    <span class="palette-target-label">Apply to:</span>
                    <div class="palette-toggle">
                        <button type="button"
                                class="@(paletteTarget == PaletteTarget.Foreground ? "active" : null)"
                                @onclick="() => paletteTarget = PaletteTarget.Foreground">Foreground</button>
                        <button type="button"
                                class="@(paletteTarget == PaletteTarget.Background ? "active" : null)"
                                @onclick="() => paletteTarget = PaletteTarget.Background">Background</button>
                    </div>
                </div>
                <div class="palette">
                    @foreach (var color in palette)
                    {
                        <span class="palette-swatch"
                              style="background:@color"
                              title="@color"
                              @onclick="() => OnPaletteClick(color)"></span>
                    }
                </div>
            </section>

            <section class="panel">
                <h2 class="panel-title">Tool</h2>
                <select @bind="toolMode" class="tool-select full-width">
                    <option value="@ToolMode.Paint">Paint</option>
                    <option value="@ToolMode.Fill">Fill</option>
                    <option value="@ToolMode.Sample">Sample</option>
                </select>
                <div class="field tool-channels">
                    <label class="checkbox">
                        <input type="checkbox" @bind="applyBackground" />
                        Background
                    </label>
                    <label class="checkbox">
                        <input type="checkbox" @bind="applyForeground" />
                        Foreground
                    </label>
                    <label class="checkbox">
                        <input type="checkbox" @bind="applyCharacter" />
                        Character
                    </label>
                </div>
            </section>

            <section class="panel">
                <h2 class="panel-title">Replace</h2>
                <div class="field">
                    <label>Target</label>
                    <select @bind="replaceTarget" class="tool-select full-width">
                        <option value="@ReplaceTarget.Foreground">Foreground Color</option>
                        <option value="@ReplaceTarget.Background">Background Color</option>
                        <option value="@ReplaceTarget.Character">Character</option>
                    </select>
                </div>
                <div class="field-row">
                    <div class="field">
                        <label>From</label>
                        @if (replaceTarget == ReplaceTarget.Character)
                        {
                            <input type="text" maxlength="1" @bind="replaceFromChar" class="char-input" />
                        }
                        else
                        {
                            <input type="color" @bind="replaceFromColor" />
                        }
                    </div>
                    <div class="field">
                        <label>To (from brush)</label>
                        @if (replaceTarget == ReplaceTarget.Character)
                        {
                            <span class="replace-to">'@brushChar'</span>
                        }
                        else if (replaceTarget == ReplaceTarget.Background)
                        {
                            <span class="swatch" style="background:@background"></span>
                        }
                        else
                        {
                            <span class="swatch" style="background:@foreground"></span>
                        }
                    </div>
                </div>
                <button class="btn btn-outline-primary btn-sm full-width" @onclick="ReplaceAll">Replace All</button>
            </section>
        </aside>

        <main class="canvas-area">
            <section class="panel canvas-panel">
                <div class="canvas-header">
                    <h2 class="panel-title">Canvas</h2>
                    <div class="zoom-controls">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ZoomOut" title="Zoom out">&minus;</button>
                        <span class="zoom-level">@($"{zoom * 100:0}%")</span>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ZoomIn" title="Zoom in">+</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="FitToView" title="Fit to view">Fit</button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ResetView" title="Reset to 100%">100%</button>
                    </div>
                </div>
                <div class="grid-wrapper"
                     @ref="gridWrapper"
                     @onmouseup="OnViewportMouseUp"
                     @onmouseleave="OnViewportMouseLeave"
                     @onmousemove="OnViewportMouseMove"
                     @onmousedown="OnViewportMouseDown"
                     @onwheel="OnViewportWheel"
                     @onwheel:preventDefault="true">
                    <div class="grid-transform" style="transform: translate(@(FormattableString.Invariant($"{panX}px, {panY}px"))) scale(@FormattableString.Invariant($"{zoom}")); transform-origin: top left;">
                        <table class="cell-grid">
                            <tbody>
                                @for (var y = 0; y < height; y++)
                                {
                                    var row = y;
                                    <tr>
                                        @for (var x = 0; x < width; x++)
                                        {
                                            var col = x;
                                            var cell = cells[row][col];
                                            <CellView Row="row"
                                                      Col="col"
                                                      Character="@cell.Character"
                                                      Foreground="@cell.Foreground"
                                                      Background="@cell.Background"
                                                      WidthPx="@CellWidthPx"
                                                      HeightPx="@CellHeightPx"
                                                      OnDown="HandleCellDown"
                                                      OnEnter="HandleCellEnter" />
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <section class="panel serialized">
                <div class="serialized-header">
                    <h2 class="panel-title">Serialized</h2>
                    <div class="serialized-actions">
                        <label class="auto-update">
                            <input type="checkbox" @bind="AutoUpdateString" />
                            Auto-update on change
                        </label>
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="UpdateStringFromCells"
                                disabled="@autoUpdateString">
                            Update
                        </button>
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="CopyStringToClipboard">
                            Copy
                        </button>
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="PasteStringFromClipboard">
                            Paste
                        </button>
                    </div>
                </div>
                <textarea id="grid-string"
                          class="grid-string"
                          spellcheck="false"
                          value="@gridString"
                          @oninput="OnStringInput"
                          @onkeydown:preventDefault="true"
                          @onchange="OnStringChanged"></textarea>
                @if (!string.IsNullOrEmpty(parseError))
                {
                    <div class="parse-error">@parseError</div>
                }
            </section>
        </main>
    </div>
</div>

@code {
    private enum ToolMode
    {
        Paint,
        Fill,
        Sample
    }

    private enum ReplaceTarget
    {
        Foreground,
        Background,
        Character
    }

    private enum PaletteTarget
    {
        Foreground,
        Background
    }

    private enum TexturizerOption
    {
        None,
        Brightness
    }

    private enum AspectRatioOption
    {
        Console,
        Square,
        Custom
    }

    private class Cell
    {
        public string Foreground { get; set; } = "#ffffff";
        public string Background { get; set; } = "#000000";
        public string Character { get; set; } = " ";
    }

    private const int BaseCellSize = 24;

    private int width = 40;
    private int height = 20;
    private int pendingWidth = 40;
    private int pendingHeight = 20;
    private double cellRatioWidth = 0.55;
    private double cellRatioHeight = 1;
    private string foreground = "#ffffff";
    private string background = "#000000";
    private string brushChar = "#";
    private ToolMode toolMode = ToolMode.Paint;
    private bool applyBackground = true;
    private bool applyForeground = true;
    private bool applyCharacter = true;
    private PaletteTarget paletteTarget = PaletteTarget.Foreground;
    private bool isDrawing;
    private List<List<Cell>> cells = new();
    private List<string> palette = new();

    private string gridString = string.Empty;
    private string? parseError;
    private bool autoUpdateString = true;

    private bool AutoUpdateString
    {
        get => autoUpdateString;
        set
        {
            autoUpdateString = value;

            // publish an update as soon as auto-update is enabled.
            if (value)
                SyncStringFromCells();
        }
    }

    private string imageUrl = string.Empty;

    private ReplaceTarget replaceTarget = ReplaceTarget.Foreground;
    private string replaceFromColor = "#000000";
    private string replaceFromChar = "#";

    private TexturizerOption selectedTexturizer = TexturizerOption.None;

    private AspectRatioOption selectedAspectRatioValue = AspectRatioOption.Console;

    private AspectRatioOption selectedAspectRatio
    {
        get => selectedAspectRatioValue;
        set
        {
            selectedAspectRatioValue = value;

            switch (value)
            {
                case AspectRatioOption.Console:
                    cellRatioWidth = CellAspectRatio.Console.Width;
                    cellRatioHeight = CellAspectRatio.Console.Height;
                    break;
                case AspectRatioOption.Square:
                    cellRatioWidth = CellAspectRatio.Square.Width;
                    cellRatioHeight = CellAspectRatio.Square.Height;
                    break;
            }
        }
    }

    // pan/zoom view state
    private ElementReference gridWrapper;
    private double zoom = 1.0;
    private double panX = 0;
    private double panY = 0;
    private bool isPanning;
    private double lastPointerX;
    private double lastPointerY;

    private const double MinZoom = 0.1;
    private const double MaxZoom = 8.0;
    private const double ZoomStep = 1.2;

    private const int MaxWidth = 1000;
    private const int MaxHeight = 1000;

    private string CellWidthPx => FormattableString.Invariant($"{BaseCellSize * Math.Max(0.1, cellRatioWidth)}px");
    private string CellHeightPx => FormattableString.Invariant($"{BaseCellSize * Math.Max(0.1, cellRatioHeight)}px");

    protected override void OnInitialized()
    {
        BuildGrid();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await FitToView();
    }

    private void BuildGrid()
    {
        cells = new List<List<Cell>>();
        for (var y = 0; y < height; y++)
        {
            var row = new List<Cell>();
            for (var x = 0; x < width; x++)
                row.Add(new Cell());
            cells.Add(row);
        }
        RebuildPalette();
    }

    private ITexturizer CreateTexturizer() => selectedTexturizer switch
    {
        TexturizerOption.Brightness => new BrightnessTexturizer(),
        _ => new NoTexturizer()
    };

    private async Task LoadImage(InputFileChangeEventArgs e)
    {
        parseError = null;

        try
        {
            var targetSize = new Size(Math.Clamp(pendingWidth, 1, MaxWidth), Math.Clamp(pendingHeight, 1, MaxHeight));
            var aspectRatio = new CellAspectRatio(cellRatioWidth, cellRatioHeight);

            using var stream = new MemoryStream();
            await e.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(stream);
            stream.Position = 0;

            var builder = VisualHelper.FromImage(stream, targetSize, aspectRatio, CreateTexturizer());
            LoadFromBuilder(builder);
            await FitToView();
        }
        catch (Exception ex)
        {
            parseError = $"Could not load image: {ex.Message}";
        }
    }

    private async Task LoadImageFromUrl()
    {
        parseError = null;

        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            parseError = "Please enter an image URL.";
            return;
        }

        try
        {
            var targetSize = new Size(Math.Clamp(pendingWidth, 1, MaxWidth), Math.Clamp(pendingHeight, 1, MaxHeight));
            var aspectRatio = new CellAspectRatio(cellRatioWidth, cellRatioHeight);

            var bytes = await Http.GetByteArrayAsync(imageUrl);
            using var stream = new MemoryStream(bytes);

            var builder = VisualHelper.FromImage(stream, targetSize, aspectRatio, CreateTexturizer());
            LoadFromBuilder(builder);
            await FitToView();
        }
        catch (Exception ex)
        {
            parseError = $"Could not load image from URL: {ex.Message}";
        }
    }

    private void LoadFromBuilder(GridVisualBuilder builder)
    {
        var newWidth = Math.Clamp(builder.DisplaySize.Width, 1, MaxWidth);
        var newHeight = Math.Clamp(builder.DisplaySize.Height, 1, MaxHeight);

        var newCells = new List<List<Cell>>();
        for (var y = 0; y < newHeight; y++)
        {
            var row = new List<Cell>();
            for (var x = 0; x < newWidth; x++)
            {
                var character = builder.GetCharacter(x, y);
                row.Add(new Cell
                {
                    Character = character == '\0' ? " " : character.ToString(),
                    Foreground = AnsiToHex(builder.GetCellForegroundColor(x, y)),
                    Background = AnsiToHex(builder.GetCellBackgroundColor(x, y))
                });
            }
            newCells.Add(row);
        }

        width = newWidth;
        height = newHeight;
        pendingWidth = newWidth;
        pendingHeight = newHeight;
        cells = newCells;

        RebuildPalette();
    }

    private async Task ResizeGrid()
    {
        var newWidth = Math.Clamp(pendingWidth, 1, MaxWidth);
        var newHeight = Math.Clamp(pendingHeight, 1, MaxHeight);

        var newCells = new List<List<Cell>>();
        for (var y = 0; y < newHeight; y++)
        {
            var row = new List<Cell>();
            for (var x = 0; x < newWidth; x++)
            {
                if (y < cells.Count && x < cells[y].Count)
                    row.Add(cells[y][x]);
                else
                    row.Add(new Cell());
            }
            newCells.Add(row);
        }

        width = newWidth;
        height = newHeight;
        pendingWidth = newWidth;
        pendingHeight = newHeight;
        cells = newCells;
        RebuildPalette();
        await FitToView();
    }

    private void ClearGrid()
    {
        foreach (var row in cells)
        {
            foreach (var cell in row)
            {
                cell.Character = " ";
                cell.Background = "#000000";
                cell.Foreground = "#ffffff";
            }
        }
        RebuildPalette();
    }

    private void HandleCellDown((int Row, int Col) pos)
    {
        StartPaint(pos.Row, pos.Col);
    }

    private void HandleCellEnter((int Row, int Col) pos)
    {
        PaintIfDrawing(pos.Row, pos.Col);
    }

    private void StartPaint(int row, int col)
    {
        if (toolMode == ToolMode.Sample)
        {
            SampleCell(row, col);
            return;
        }

        if (toolMode == ToolMode.Fill)
        {
            FloodFill(row, col);
            return;
        }

        isDrawing = true;
        ApplyBrush(row, col);
    }

    private void SampleCell(int row, int col)
    {
        var cell = cells[row][col];
        if (applyForeground)
            foreground = cell.Foreground;
        if (applyBackground)
            background = cell.Background;
        if (applyCharacter)
            brushChar = cell.Character;
    }

    private void PaintIfDrawing(int row, int col)
    {
        if (isDrawing)
            ApplyBrush(row, col);
    }

    private void EndPaint()
    {
        if (!isDrawing)
            return;

        isDrawing = false;

        // commit palette/string refresh once, at the end of the stroke, instead of per-cell.
        RebuildPalette();
    }

    // ----- Pan / Zoom -----

    private sealed class ViewSize
    {
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private sealed class ViewRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private void OnViewportMouseDown(MouseEventArgs e)
    {
        // middle button, or left button with space/ctrl held, starts panning instead of painting.
        var panRequested = e.Button == 1 || (e.Button == 0 && (e.CtrlKey || e.ShiftKey));
        if (!panRequested)
            return;

        isPanning = true;
        lastPointerX = e.ClientX;
        lastPointerY = e.ClientY;
    }

    private void OnViewportMouseMove(MouseEventArgs e)
    {
        if (!isPanning)
            return;

        panX += e.ClientX - lastPointerX;
        panY += e.ClientY - lastPointerY;
        lastPointerX = e.ClientX;
        lastPointerY = e.ClientY;
    }

    private void OnViewportMouseUp(MouseEventArgs e)
    {
        isPanning = false;
        EndPaint();
    }

    private void OnViewportMouseLeave(MouseEventArgs e)
    {
        isPanning = false;
        EndPaint();
    }

    private async Task OnViewportWheel(WheelEventArgs e)
    {
        var factor = e.DeltaY < 0 ? ZoomStep : 1 / ZoomStep;
        var newZoom = Math.Clamp(zoom * factor, MinZoom, MaxZoom);
        if (Math.Abs(newZoom - zoom) < 0.0001)
            return;

        // zoom toward the cursor so the point under the pointer stays put.
        var rect = await GetViewportRectAsync();
        var cursorX = e.ClientX - rect.Left;
        var cursorY = e.ClientY - rect.Top;

        // content coordinate currently under the cursor.
        var contentX = (cursorX - panX) / zoom;
        var contentY = (cursorY - panY) / zoom;

        zoom = newZoom;
        panX = cursorX - contentX * zoom;
        panY = cursorY - contentY * zoom;
    }

    private void ZoomIn() => SetZoomAroundCenter(Math.Clamp(zoom * ZoomStep, MinZoom, MaxZoom));

    private void ZoomOut() => SetZoomAroundCenter(Math.Clamp(zoom / ZoomStep, MinZoom, MaxZoom));

    private async void SetZoomAroundCenter(double newZoom)
    {
        if (Math.Abs(newZoom - zoom) < 0.0001)
            return;

        var size = await GetViewportSizeAsync();
        var centerX = size.Width / 2;
        var centerY = size.Height / 2;

        var contentX = (centerX - panX) / zoom;
        var contentY = (centerY - panY) / zoom;

        zoom = newZoom;
        panX = centerX - contentX * zoom;
        panY = centerY - contentY * zoom;

        StateHasChanged();
    }

    private void ResetView()
    {
        zoom = 1.0;
        panX = 0;
        panY = 0;
    }

    private async Task FitToView()
    {
        var size = await GetViewportSizeAsync();
        if (size.Width <= 0 || size.Height <= 0)
            return;

        var contentWidth = width * BaseCellSize * Math.Max(0.1, cellRatioWidth);
        var contentHeight = height * BaseCellSize * Math.Max(0.1, cellRatioHeight);
        if (contentWidth <= 0 || contentHeight <= 0)
            return;

        var scale = Math.Min(size.Width / contentWidth, size.Height / contentHeight);
        zoom = Math.Clamp(scale, MinZoom, MaxZoom);

        // center the content within the viewport.
        panX = Math.Max(0, (size.Width - contentWidth * zoom) / 2);
        panY = Math.Max(0, (size.Height - contentHeight * zoom) / 2);

        StateHasChanged();
    }

    private async Task<ViewSize> GetViewportSizeAsync()
    {
        try
        {
            return await JS.InvokeAsync<ViewSize>("canvasView.getViewportSize", gridWrapper);
        }
        catch
        {
            return new ViewSize();
        }
    }

    private async Task<ViewRect> GetViewportRectAsync()
    {
        try
        {
            return await JS.InvokeAsync<ViewRect>("canvasView.getRect", gridWrapper);
        }
        catch
        {
            return new ViewRect();
        }
    }

    private void ApplyBrush(int row, int col)
    {
        ApplyChannels(cells[row][col]);
    }

    private void ApplyChannels(Cell cell)
    {
        if (applyForeground)
            cell.Foreground = foreground;
        if (applyBackground)
            cell.Background = background;
        if (applyCharacter)
            cell.Character = string.IsNullOrEmpty(brushChar) ? " " : brushChar;
    }

    private void FloodFill(int startRow, int startCol)
    {
        // if no channel is selected there is nothing to fill.
        if (!applyForeground && !applyBackground && !applyCharacter)
            return;

        var target = cells[startRow][startCol];
        var matchForeground = target.Foreground;
        var matchBackground = target.Background;
        var matchCharacter = target.Character;

        // a cell is contiguous if every selected channel matches the starting cell.
        bool Matches(Cell c)
        {
            if (applyForeground && !string.Equals(c.Foreground, matchForeground, StringComparison.OrdinalIgnoreCase))
                return false;
            if (applyBackground && !string.Equals(c.Background, matchBackground, StringComparison.OrdinalIgnoreCase))
                return false;
            if (applyCharacter && !string.Equals(c.Character, matchCharacter, StringComparison.Ordinal))
                return false;
            return true;
        }

        var visited = new bool[height, width];
        var queue = new Queue<(int Row, int Col)>();
        queue.Enqueue((startRow, startCol));
        visited[startRow, startCol] = true;

        while (queue.Count > 0)
        {
            var (row, col) = queue.Dequeue();
            var cell = cells[row][col];
            if (!Matches(cell))
                continue;

            ApplyChannels(cell);

            foreach (var (dr, dc) in new[] { (-1, 0), (1, 0), (0, -1), (0, 1) })
            {
                var nr = row + dr;
                var nc = col + dc;
                if (nr < 0 || nr >= height || nc < 0 || nc >= width || visited[nr, nc])
                    continue;
                visited[nr, nc] = true;
                if (Matches(cells[nr][nc]))
                    queue.Enqueue((nr, nc));
            }
        }

        RebuildPalette();
    }

    private void OnPaletteClick(string color)
    {
        // apply the clicked color to whichever channel the toggle targets.
        if (paletteTarget == PaletteTarget.Background)
            background = color;
        else
            foreground = color;
    }

    private void ReplaceAll()
    {
        foreach (var row in cells)
        {
            foreach (var cell in row)
            {
                switch (replaceTarget)
                {
                    case ReplaceTarget.Foreground:
                        if (string.Equals(cell.Foreground, replaceFromColor, StringComparison.OrdinalIgnoreCase))
                            cell.Foreground = foreground;
                        break;
                    case ReplaceTarget.Background:
                        if (string.Equals(cell.Background, replaceFromColor, StringComparison.OrdinalIgnoreCase))
                            cell.Background = background;
                        break;
                    case ReplaceTarget.Character:
                        var from = string.IsNullOrEmpty(replaceFromChar) ? " " : replaceFromChar;
                        var to = string.IsNullOrEmpty(brushChar) ? " " : brushChar;
                        if (string.Equals(cell.Character, from, StringComparison.Ordinal))
                            cell.Character = to;
                        break;
                }
            }
        }

        RebuildPalette();
    }

    private void RebuildPalette()
    {
        var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var row in cells)
        {
            foreach (var cell in row)
            {
                set.Add(cell.Foreground);
                set.Add(cell.Background);
                if (set.Count >= 100)
                    break;
            }
            if (set.Count >= 100)
                break;
        }
        palette = set.Take(100).ToList();

        if (autoUpdateString)
            SyncStringFromCells();
    }

    private void UpdateStringFromCells()
    {
        SyncStringFromCells();
    }

    private void SyncStringFromCells()
    {
        var builder = new GridVisualBuilder(AnsiColor.Black, AnsiColor.White);
        builder.Resize(new Size(width, height));

        for (var y = 0; y < height; y++)
        {
            for (var x = 0; x < width; x++)
            {
                var cell = cells[y][x];
                var character = string.IsNullOrEmpty(cell.Character) ? ' ' : cell.Character[0];
                builder.SetCell(x, y, character, HexToAnsi(cell.Foreground), HexToAnsi(cell.Background));
            }
        }

        gridString = builder.ToString();
        parseError = null;
    }

    private async Task OnStringChanged(ChangeEventArgs e)
    {
        var data = e.Value?.ToString() ?? string.Empty;
        gridString = data;
        await RenderFromString(gridString);
    }

    private async Task OnStringInput(ChangeEventArgs e)
    {
        gridString = e.Value?.ToString() ?? string.Empty;
        await RenderFromString(gridString);
    }

    private async Task CopyStringToClipboard()
    {
        await JS.InvokeVoidAsync("clipboard.copy", gridString);
    }

    private async Task PasteStringFromClipboard()
    {
        var data = await JS.InvokeAsync<string>("clipboard.paste");

        // replace all previous text with the pasted content.
        gridString = data ?? string.Empty;
        await RenderFromString(gridString);
    }

    private async Task RenderFromString(string data)
    {
        if (string.IsNullOrWhiteSpace(data))
            return;

        GridVisualBuilder builder;
        try
        {
            builder = GridVisualBuilder.FromString(data);
        }
        catch (Exception ex)
        {
            parseError = $"Could not parse string: {ex.Message}";
            return;
        }

        LoadFromBuilder(builder);
        await FitToView();
    }

    private static AnsiColor HexToAnsi(string hex)
    {
        if (string.IsNullOrEmpty(hex))
            return AnsiColor.Black;

        var value = hex.TrimStart('#');
        if (value.Length != 6)
            return AnsiColor.Black;

        var r = Convert.ToByte(value.Substring(0, 2), 16);
        var g = Convert.ToByte(value.Substring(2, 2), 16);
        var b = Convert.ToByte(value.Substring(4, 2), 16);
        return new AnsiColor(r, g, b);
    }

    private static string AnsiToHex(AnsiColor color)
    {
        return $"#{color.R:x2}{color.G:x2}{color.B:x2}";
    }
}
